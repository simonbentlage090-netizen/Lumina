<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12: eigener Startbildschirm. Das Licht im Lumina-Zeichen leuchtet auf. -->
    <style name="Theme.Funke" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lumina_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/lumina_window</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">800</item>
    </style>
</resources>
