<?xml version="1.0" encoding="utf-8"?>
<!-- Knopf im Lumi-Widget, wenn Lumi friert. Beim Drücken etwas dunkler, damit man sieht, dass der Tipp angekommen ist. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_ice_pressed" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_ice" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
