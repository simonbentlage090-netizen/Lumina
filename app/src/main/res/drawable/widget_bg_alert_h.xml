<?xml version="1.0" encoding="utf-8"?>
<!-- Lumi-Widget, Stimmung "alert" (breit: Lichtschein links bei Lumi). Ein weicher Schein in der Stimmungsfarbe,
     der zur ruhigen Kartenfarbe ausläuft. Ecken wie die System-Widgets (ab Android 12). -->
