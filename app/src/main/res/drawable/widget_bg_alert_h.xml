    <gradient
        android:centerX="0.2"
        android:centerY="0.55"
        android:endColor="@color/w_bg"
        android:gradientRadius="95%"
        android:startColor="#FFFFDCD3"
        android:type="radial" />
    <corners android:radius="@dimen/w_radius" />
</shape>
