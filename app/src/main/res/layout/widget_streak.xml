<?xml version="1.0" encoding="utf-8"?>
<!--
  Streak-Widget (klein): Flamme und Zahl groß in der Mitte, darunter die Einheit und eine Kapsel, ob heute
  schon gelesen wurde. Seit 13.0 ohne Streak-Eis: Wer "noch 2 Eis" sieht, lässt eher einen Tag aus.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_flame"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_flame" />

            <TextView
                android:id="@+id/w_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="0"
                android:textColor="@color/w_text"
                android:textSize="44sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/widget_streak_word"
            android:textColor="@color/w_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_status_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_chip_done"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="@string/widget_today_done"
            android:textColor="@color/w_accent_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_status_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="@string/widget_today_open"
            android:textColor="@color/w_sub"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
