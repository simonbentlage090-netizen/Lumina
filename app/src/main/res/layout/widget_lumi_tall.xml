<?xml version="1.0" encoding="utf-8"?>
<!--
  Lumi-Widget, hoch (z. B. 2x3 oder 4x3). Seit 12.0: wie ein kleines Plakat – Lumi groß oben im Lichtschein,
  darunter ggf. eine große Zahl, die Überschrift, der Fortschritt zum Tagesziel und ein großer Knopf
  über die ganze Breite. Abstände auf einem 8-dp-Raster.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_warm_v"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/w_lumi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lumi"
        android:scaleType="fitCenter"
        android:src="@drawable/lumi_w_hello" />

    <TextView
        android:id="@+id/w_big"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="48sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:maxLines="1"
        android:textColor="@color/w_accent_text"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/w_chrono"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:countDown="true"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/w_alert"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="13sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.01"
        android:lineSpacingMultiplier="0.95"
        android:maxLines="2"
        android:text="@string/widget_preview_title"
        android:textColor="@color/w_text"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:id="@+id/w_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/w_goal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/w_goal_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/w_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_cta"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/widget_btn_accent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/widget_preview_cta"
        android:textColor="@color/w_on_accent"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
