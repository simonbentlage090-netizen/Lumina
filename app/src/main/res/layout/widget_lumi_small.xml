<?xml version="1.0" encoding="utf-8"?>
<!-- Lumi-Widget, klein (2x2): Lumi im Lichtschein und darunter entweder die Überschrift oder die große Zahl.
     Kein Knopf: Das ganze Widget ist der Knopf. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_warm_v"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_lumi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lumi"
        android:scaleType="fitCenter"
        android:src="@drawable/lumi_w_hello" />

    <TextView
        android:id="@+id/w_big"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/w_accent_text"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/w_chrono"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="30sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:countDown="true"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/w_alert"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="18sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_preview_title"
        android:textColor="@color/w_text"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
